{
  "scripts": {
    "build": "pnpm run build:ts && pnpm run build:rust && pnpm run build:sbf",
    "build:ts": "turbo run build",
    "build:rust": "cargo build --workspace",
    "build:sbf": "pnpm run build:sbf:dropset && pnpm run build:sbf:pack-orders && pnpm run build:sbf:to-order-info",
    "build:sbf:debug": "cd program && cargo build-sbf --features debug --arch v2",
    "build:sbf:dropset": "cd program && cargo build-sbf --arch v2",
    "build:sbf:pack-orders": "cd cu-bench/programs/pack-orders && cargo build-sbf --arch v2",
    "build:sbf:to-order-info": "cd cu-bench/programs/to-order-info && cargo build-sbf --arch v2",
    "check": "pnpm run check:ts && pnpm run check:rust",
    "check:ts": "turbo run check",
    "check:rust": "cargo check --workspace --all-targets",
    "check:bench": "pnpm run check:bench:manifest && pnpm run check:bench:phoenix",
    "check:bench:manifest": "cd cu-bench/manifest && cargo check --tests",
    "check:bench:phoenix": "cd cu-bench/phoenix && cargo check --tests",
    "check:all": "pnpm run check && pnpm run check:bench",
    "lint": "pnpm run lint:ts && pnpm run lint:rust",
    "lint:ts": "turbo run lint",
    "lint:rust": "cargo +nightly clippy --workspace --all-targets -- -D warnings",
    "format": "pnpm run format:ts && pnpm run format:json && pnpm run format:rust",
    "format:ts": "turbo run format",
    "format:json": "biome format --write **/*.json",
    "format:rust": "cargo +nightly fmt --all",
    "test": "pnpm run test:ts && pnpm run test:rust",
    "test:ts": "turbo run test",
    "test:rust": "cargo test --workspace",
    "clean": "pnpm run clean:ts && pnpm run clean:rust",
    "clean:ts": "turbo run clean --no-cache --force && rm -rf .turbo",
    "clean:rust": "cargo clean",
    "doc": "cargo doc --no-deps --document-private-items --workspace",
    "bench:dropset": "bash cu-bench/dropset/run-bench.sh",
    "bench:manifest": "bash cu-bench/manifest/run-bench.sh",
    "bench:pack-orders": "bash cu-bench/pack-orders.sh",
    "bench:phoenix": "bash cu-bench/phoenix/run-bench.sh",
    "bench:to-order-info": "bash cu-bench/to-order-info.sh",
    "service:faucet": "cargo run -p dropset-faucet",
    "service:faucet:docker": "docker compose -f services/faucet/compose.yaml up --build -d",
    "service:maker": "cargo run -p dropset-maker-bot",
    "service:maker:docker": "docker compose -f services/maker-bot/compose.yaml up --build -d",
    "service:taker": "cargo run -p dropset-taker-bot",
    "service:taker:docker": "docker compose -f services/taker-bot/compose.yaml up --build -d",
    "tool:install:cargo-expand": "cargo +nightly install cargo-expand",
    "deploy:localnet": "solana program deploy -u localhost target/deploy/dropset.so --program-id test-keypair.json"
  },
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24.14.1"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "turbo": "^2.9.1"
  }
}
