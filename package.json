{
  "scripts": {
    "bench:dropset": "bash cu-bench/dropset/run-bench.sh",
    "bench:manifest": "bash cu-bench/manifest/run-bench.sh",
    "bench:pack-orders": "bash cu-bench/pack-orders.sh",
    "bench:phoenix": "bash cu-bench/phoenix/run-bench.sh",
    "bench:to-order-info": "bash cu-bench/to-order-info.sh",
    "build-deps": "cargo build --workspace",
    "build-dev-deps": "cargo +nightly install cargo-expand",
    "build": "pnpm run build:dropset && pnpm run build:pack-orders && pnpm run build:to-order-info",
    "build:debug": "cd program && cargo build-sbf --features debug --arch v2",
    "build:dropset": "cd program && cargo build-sbf --arch v2",
    "build:pack-orders": "cd cu-bench/programs/pack-orders && cargo build-sbf --arch v2",
    "build:to-order-info": "cd cu-bench/programs/to-order-info && cargo build-sbf --arch v2",
    "check": "cargo check --examples --tests",
    "check:all": "pnpm run check && pnpm run check:bench-manifest && pnpm run check:bench-phoenix",
    "check:bench-manifest": "cd cu-bench/manifest && cargo check --tests",
    "check:bench-phoenix": "cd cu-bench/phoenix && cargo check --tests",
    "clean": "cargo clean",
    "clippy": "cargo +nightly clippy --all-targets -- -D warnings",
    "deploy": "solana program deploy -u localhost target/deploy/dropset.so --program-id test-keypair.json",
    "format": "cargo +nightly fmt --all",
    "services:maker": "cargo run -p dropset-maker-bot",
    "services:maker:docker": "docker compose -f services/maker-bot/compose.yaml up --build -d",
    "services:taker": "cargo run -p dropset-taker-bot",
    "services:taker:docker": "docker compose -f services/taker-bot/compose.yaml up --build -d",
    "services:faucet": "cargo run -p dropset-faucet",
    "services:faucet:docker": "docker compose -f services/faucet/compose.yaml up --build -d",
    "test": "pnpm run build && cargo test"
  },
  "packageManager": "pnpm@10.30.3"
}
