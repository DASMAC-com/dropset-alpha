# Note that this config extends the config in `shared/config.toml`.
# Things like the base/quote mint addresses and the RPC url are
# specified there, not here.
# --

# Whether or not to print the prettified, verbose parsed transaction data logs.
verbose = false

# ------------------------------------------------------------------
# Taker agents
#
# Every `[[agent]]` block spawns one independent participant inside this
# service, sharing the same RPC and faucet clients. Each agent picks a named
# `archetype` (one of: passive, retail, aggressive, whale, sniper, noise) which
# supplies defaults for every other field. Any field set here overrides that
# preset.
#
# `name` is free-form and appears in the agent's tracing span.
# `keypair_path` is resolved relative to this file's directory if not absolute.
# `seed` is optional; omit for a random seed each run.

[[agent]]
name = "retail-1"
archetype = "retail"
keypair_path = "keypairs/retail-1.json"

[[agent]]
name = "whale-1"
archetype = "whale"
keypair_path = "keypairs/whale-1.json"

[[agent]]
name = "sniper-1"
archetype = "sniper"
keypair_path = "keypairs/sniper-1.json"

[[agent]]
name = "noise-1"
archetype = "noise"
keypair_path = "keypairs/noise-1.json"
# ------------------------------------------------------------------
