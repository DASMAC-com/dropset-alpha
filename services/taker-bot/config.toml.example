# Note that this config extends the config in `shared/config.toml`.
# Things like the base/quote mint addresses and the RPC url are
# specified there, not here.
# --

# Whether or not to print the prettified, verbose parsed transaction data logs.
verbose = false

# ------------------------------------------------------------------
# Taker strategy

[strategy]
# Milliseconds between ticks of the interval loop.
interval_ms = 750

# Base arrival rate (orders/tick) during quiet periods.
lambda_quiet = 0.5

# Arrival rate during an active burst.
lambda_burst = 5.0

# Probability of entering a burst each quiet tick.
burst_entry_prob = 0.1

# Probability of exiting the burst each tick (controls burst duration).
burst_exit_prob = 0.3

# Median order size in base atoms.
median_order_size = 3000

# Order size spread: sizes range roughly from median/x to median*x.
spread_multiplier = 2.0

# Probability the next order is a buy (0.0–1.0).
buy_bias = 0.5

# Optional RNG seed for reproducible runs (comment out for random).
# seed = 42
# ------------------------------------------------------------------
